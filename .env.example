DB_NAME=project_tracker
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Azure Database for PostgreSQL requires TLS: use "require" there.
DB_SSLMODE=prefer
# Generate a unique high-entropy value for each environment.
DJANGO_SECRET_KEY=replace-with-a-unique-high-entropy-secret
DJANGO_DEBUG=False
# Comma-separated. Include the API's internal name (e.g. "api") when it sits behind the web proxy.
DJANGO_ALLOWED_HOSTS=
# Production only (the container image sets DJANGO_ENFORCE_HTTPS=true by default):
# DJANGO_ENFORCE_HTTPS=true
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# DJANGO_ENABLE_API_DOCS=false
# DRF_NUM_PROXIES=2   # set only after verifying the proxy chain (see DEPLOYMENT notes)
